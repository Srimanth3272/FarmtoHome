# Farm to Home Environment Configuration
DATABASE_URL="file:./dev.db" # or "postgresql://user:password@localhost:5432/farmtohome?schema=public"
JWT_SECRET="your-secure-jwt-secret"
APP_NAME="Farm to Home"
APP_SLOGAN="Fresh from the Farm. Naturally to Your Home."
APP_URL="http://localhost:3000"

# Optional Agricultural AI Assistant (Google Gemini / Custom LLM)
GEMINI_API_KEY="your-gemini-api-key"

# Payment Gateway (Razorpay / UPI test configuration)
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"

# Google OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# Firebase Real-time Firestore Configuration (without NEXT_PUBLIC_)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_MEASUREMENT_ID=""
